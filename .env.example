# Copia este archivo como `.env` y completa los valores para desarrollo local.
# `.env` está en .gitignore: nunca se versionan sus valores.
# La clave «anon» de Supabase es pública (viaja al navegador), pero se mantiene fuera del repositorio.

# Proyecto Supabase Auth (mismo proyecto que valida el backend por JWKS)
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave anon del proyecto Supabase>

# Backend FastAPI desplegado (sin barra final)
VITE_API_URL=https://cotizador-farmacia-demo-3ea67af09b39.herokuapp.com
